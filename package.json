{
  "name": "internship-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:reset": "node server/db/reset.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "googleapis": "^190.0.0",
    "lucide-react": "^1.73.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
