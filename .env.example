# --- Server ---
PORT=4000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:4000
# Where OAuth callbacks send the browser. Leave blank to return to the same
# origin when a production build exists, or to http://localhost:5173 in dev.
# CLIENT_BASE_URL=http://localhost:5173
# Absolutise as needed. Data directory holds the SQLite DB, uploads and resume.
DATA_DIR=data

# --- Crawling / politeness ---
CRAWL_MAX_PAGES=12
CRAWL_TIMEOUT_MS=12000
CRAWL_DELAY_MS=250
CRAWL_USER_AGENT=InternshipOutreachBot/0.1 (+contact: local operator; respects robots.txt)

# --- Web search (pick one) ---
# auto | serpapi | google_cse | none
SEARCH_PROVIDER=auto
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Professional email discovery / verification ---
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
APOLLO_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# --- Google OAuth 2.0 (Gmail send + read, optional Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=

# 32+ random characters. Encrypts OAuth refresh tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional allowlist of Gmail accounts allowed to connect (comma separated).
ALLOWED_SENDER_EMAILS=

# --- Access control ---
# Required when NODE_ENV=production (the app can send email from your Gmail).
# The browser will ask for this username/password via HTTP Basic Auth.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Only for a trusted private network, never on the public internet:
# ALLOW_PUBLIC_NO_AUTH=true

# --- Safety ---
ABSOLUTE_DAILY_LIMIT=40
SEND_DRY_RUN=false
