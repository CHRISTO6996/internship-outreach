# --- Server ---
PORT=4000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:4000
# Where OAuth callbacks send the browser. Leave blank to return to the same
# origin when a production build exists, or to http://localhost:5173 in dev.
# CLIENT_BASE_URL=http://localhost:5173
# Absolute as needed. Data directory holds the SQLite DB, uploads and resume.
DATA_DIR=data

# --- Crawling / politeness ---
CRAWL_MAX_PAGES=12
CRAWL_TIMEOUT_MS=12000
CRAWL_DELAY_MS=250
# A browser-like UA avoids blanket 403s on public corporate sites.
CRAWL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# --- Web search (optional; keyless fallbacks are on by default) ---
# auto | serpapi | google_cse | duckduckgo | none
SEARCH_PROVIDER=auto
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Keyless fallbacks: DuckDuckGo HTML, then Bing via Jina Reader.
# Company-name discovery still works with no paid search key when these are true.
SEARCH_KEYLESS_FALLBACK=true
SEARCH_JINA_FALLBACK=true

# --- Professional email discovery / verification ---
HUNTER_API_KEY=
# Pingutil runs first in the verification chain (recommended).
PINGUTIL_API_KEY=
ZEROBOUNCE_API_KEY=

# --- Google OAuth 2.0 (Gmail send + read, optional Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=

# 32+ random characters. Encrypts OAuth refresh tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional allowlist of Gmail accounts allowed to connect (comma separated).
ALLOWED_SENDER_EMAILS=

# --- Access control ---
# Required when NODE_ENV=production (the app can send email from your Gmail).
# The web app shows a login screen and stores a signed session cookie.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Only for a trusted private network, never on the public internet:
# ALLOW_PUBLIC_NO_AUTH=true

# --- Safety ---
ABSOLUTE_DAILY_LIMIT=40
# true = render and queue emails but never transmit them (useful for demos).
SEND_DRY_RUN=false
